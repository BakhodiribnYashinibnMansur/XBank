# ═══════════════════════════════════════════════════
# XBank Environment Variables
# Copy this file to .env and fill in values
# ═══════════════════════════════════════════════════

# ── Application ───────────────────────────────────
APP_ENV=development                # development | production
PORT=3000

# ── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xbank?sslmode=disable
# Production: postgres://xbank_app:PASSWORD@db:5432/xbank?sslmode=verify-full&sslrootcert=/certs/ca.pem

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MongoDB (Audit Log) ──────────────────────────
MONGODB_URI=mongodb://localhost:27017

# ── Kafka ─────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Encryption ────────────────────────────────────
# 32-byte hex key for AES-256-GCM card PAN encryption
# Generate: openssl rand -hex 32
CARD_ENCRYPTION_KEY=
# 32-byte hex key for HMAC-SHA256 request signing
# Generate: openssl rand -hex 32
HMAC_SECRET=

# ── Tracing (Jaeger / OpenTelemetry) ──────────────
JAEGER_ENDPOINT=localhost:4318

# ── HashiCorp Vault (optional) ────────────────────
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_MOUNT_PATH=secret
