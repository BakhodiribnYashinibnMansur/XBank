    {
      "title": "Service Operation Error Rate",
      "type": "timeseries",
      "id": 13,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(xbank_service_operations_total{status=\"error\"}[5m])) by (service) / sum(rate(xbank_service_operations_total[5m])) by (service)",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
